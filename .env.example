SMTP_HOST=mail.netix.se
SMTP_PORT=587
SMTP_USER=discotracker@mail.netix.se
SMTP_PASS=
SMTP_FROM=Discotracker <info@discotracker.com>

# Redirect all other hostnames (e.g. www.) to this one. "discotracker.com" keeps the
# request's protocol, "https://discotracker.com" also forces https.
# Set this in production only; leave it commented out on dev.
# CANONICAL_HOST=https://discotracker.com

# Optional
# PORT=80                 # port inside the container (only exposed, never bound on the host)
# TRUST_PROXY=loopback, linklocal, uniquelocal   # which proxies may set X-Forwarded-* (nginx)
