SMTP_HOST=mail.netix.se
SMTP_PORT=587
SMTP_USER=discotracker@mail.netix.se
SMTP_PASS=
SMTP_FROM=Discotracker <info@discotracker.com>

# Optional
# Redirect all other hostnames (e.g. www.) to this one. "example.com" keeps the
# request's protocol, "https://example.com" also forces https. Leave unset locally.
# CANONICAL_HOST=https://DOMAIN_NAME
# PORT=80                 # port inside the container (only exposed, never bound on the host)
# TRUST_PROXY=loopback, linklocal, uniquelocal   # which proxies may set X-Forwarded-* (nginx)
